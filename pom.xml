<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ppcdemo</groupId>
    <artifactId>ppc-demo</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ppc-demo</name>
    <description>隐私计算 Java 技术栈 M1 PoC：PSI(mpc4j) / PHE(Paillier) / DP(Google DP) / 端到端集成</description>

    <modules>
        <module>ppc-common</module>
        <module>ppc-psi</module>
        <module>ppc-phe</module>
        <module>ppc-dp</module>
        <module>ppc-e2e</module>
        <module>ppc-bench</module>
        <module>platform/ppc-platform-core</module>
        <module>platform/ppc-platform-server</module>
        <module>platform/ppc-platform-fate</module>
        <module>engine/ppc-engine-psi</module>
    </modules>

    <properties>
        <!-- 基线 JDK 17+，本机默认 21 运行 -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- W1 核实的依赖坐标（2026-08-01，Maven Central） -->
        <javallier.version>0.6.0</javallier.version>
        <google-dp.version>4.0.0</google-dp.version>
        <!-- mpc4j 未发布 Central，源码构建后 install 到本地仓库；版本随 release tag -->
        <mpc4j.version>1.1.5</mpc4j.version>

        <slf4j.version>2.0.13</slf4j.version>
        <logback.version>1.5.6</logback.version>
        <snakeyaml.version>2.2</snakeyaml.version>
        <junit.version>5.10.2</junit.version>
        <jmh.version>1.37</jmh.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.ppcdemo</groupId>
                <artifactId>ppc-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ppcdemo</groupId>
                <artifactId>ppc-psi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ppcdemo</groupId>
                <artifactId>ppc-phe</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ppcdemo</groupId>
                <artifactId>ppc-dp</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.n1analytics</groupId>
                <artifactId>javallier_2.10</artifactId>
                <version>${javallier.version}</version>
                <exclusions>
                    <!-- 2017 年的老版本传递依赖，统一由本工程管理 -->
                    <exclusion>
                        <groupId>ch.qos.logback</groupId>
                        <artifactId>logback-classic</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>com.fasterxml.jackson.core</groupId>
                        <artifactId>jackson-databind</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>com.google.privacy.differentialprivacy</groupId>
                <artifactId>differentialprivacy</artifactId>
                <version>${google-dp.version}</version>
            </dependency>
            <!-- jnagmp 传递的 JNA 4.x 无 arm64 原生库；强制 5.x 后配合系统 libgmp
                 （-Djna.library.path=/opt/homebrew/lib）可启用 GMP modPow 加速 -->
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna</artifactId>
                <version>5.14.0</version>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>2.2.224</version>
            </dependency>
            <!-- 版本仲裁：mpc4j 线上协议由 protobuf 3.21 gencode 生成，Google DP 传递 4.30 会导致
                 引擎收包反序列化抛异常（M2.5 #3 排障结论）。DP 的加噪路径不使用 protobuf 序列化。 -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>3.21.12</version>
            </dependency>

            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>${snakeyaml.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 全模块共用 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
