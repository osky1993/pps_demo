<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ppcdemo</groupId>
        <artifactId>ppc-demo</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ppc-bench</artifactId>
    <name>ppc-bench</name>
    <description>基准测试驱动：JMH 微基准 + 端到端场景驱动（度量规范见 M1 设计文档 §7）</description>

    <dependencies>
        <dependency>
            <groupId>com.ppcdemo</groupId>
            <artifactId>ppc-phe</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ppcdemo</groupId>
            <artifactId>ppc-dp</artifactId>
        </dependency>
        <!-- PSI/PIR 运行器（M4 PirBench 依赖 com.ppcdemo.pir） -->
        <dependency>
            <groupId>com.ppcdemo</groupId>
            <artifactId>ppc-psi</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ppcdemo</groupId>
            <artifactId>ppc-platform-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 仅运行时：引擎子进程类路径来源 -->
        <dependency>
            <groupId>com.ppcdemo</groupId>
            <artifactId>ppc-engine-psi</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <!-- 依赖 ppc-psi（mpc4j preview 产物）后，本模块编译/运行同受 JDK17+preview 约束 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                        <arg>--add-modules=jdk.incubator.vector</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--enable-preview --add-modules jdk.incubator.vector</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
    
</project>
